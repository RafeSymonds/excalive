    {
      "id": "code",
      "type": "text",
      "x": 150,
      "y": 270,
      "width": 555,
      "height": 385,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 3,
      "fontSize": 28,
      "frameId": null,
      "groupIds": [],
      "index": "a3",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "def binary_search(items, target):\n\u00a0\u00a0\u00a0\u00a0lo, hi = 0, len(items) - 1\n\u00a0\u00a0\u00a0\u00a0while lo <= hi:\n\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0mid = (lo + hi) // 2\n\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0if items[mid] == target:\n\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0return mid\n\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0if items[mid] < target:\n\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0lo = mid + 1\n\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0else:\n\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0hi = mid - 1\n\u00a0\u00a0\u00a0\u00a0return -1",
      "roughness": 1,
      "roundness": null,
      "seed": 1944951308,
      "strokeColor": "#1B2547",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "def binary_search(items, target):\n\u00a0\u00a0\u00a0\u00a0lo, hi = 0, len(items) - 1\n\u00a0\u00a0\u00a0\u00a0while lo <= hi:\n\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0mid = (lo + hi) // 2\n\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0if items[mid] == target:\n\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0return mid\n\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0if items[mid] < target:\n\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0lo = mid + 1\n\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0else:\n\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0hi = mid - 1\n\u00a0\u00a0\u00a0\u00a0return -1",
      "textAlign": "left",
      "updated": 1792118976471,
      "version": 1,
      "versionNonce": 664350598,
      "verticalAlign": "top"
    },
